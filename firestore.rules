rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // LifeFlow uses three collections: inventory, donors, requests.
    // Anyone signed in — including anonymous users from signInAnonymously()
    // in firebase-config.js — can read and write all three. There's no
    // separate "admin" role here since the admin dashboard is gated by a
    // simple client-side password screen, not Firebase Auth roles; anyone
    // who can reach Firestore directly (bypassing the UI) could technically
    // write to any of these collections. That's an acceptable tradeoff for
    // a demo/small internal tool, but if this ever needs real admin-only
    // writes, look into custom claims or a separate "admins" collection
    // checked via `exists(/databases/$(database)/documents/admins/$(request.auth.uid))`.
    match /inventory/{doc} {
      allow read, write: if request.auth != null;
    }
    match /donors/{doc} {
      allow read, write: if request.auth != null;
    }
    match /requests/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
